# ── Project Specific Ignores ───────────────────────────────────────────────

# Ignore the actual Kaggle dataset images (huge file count/size)
# But keep the dataset folder structure itself in git
/dataset/**/*
!/dataset/**/
!/dataset/**/.gitkeep

# Ignore all training runs, check-points, saved weights, and plots
# But keep the results directory structure
/results/**/*
!/results/**/
!/results/**/.gitkeep
