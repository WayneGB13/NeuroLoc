# Normalize line endings to LF across different operating systems
* text=auto eol=lf

# Explicitly declare text files that should always use LF endings
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
LICENSE text eol=lf
